rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 게시글 이미지·첨부(주보) 등 — 누구나 볼 수 있고, 관리자만 업로드/삭제
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "여기에-관리자-구글이메일@gmail.com";
    }
  }
}
